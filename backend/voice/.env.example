# Copy this file to .env in this directory and fill in real values.
# Never commit the real .env file.

# Daily.co API key - used to create/join WebRTC rooms for the voice bot.
# Get one from your Daily dashboard: https://dashboard.daily.co/developers
DAILY_API_KEY=

# Deepgram API key - used for streaming speech-to-text (nova-3).
# Get one from the Deepgram console: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Anthropic API key - used for the Claude LLM step.
# Get one from the Anthropic console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cartesia API key - used for text-to-speech (Sonic).
# Get one from the Cartesia dashboard: https://play.cartesia.ai/keys
CARTESIA_API_KEY=
