# Copy this file to .env in this directory and fill in real values.
# Never commit the real .env file.

# Postgres connection string (Supabase or any real Postgres). Leave unset
# for local dev to fall back to a local SQLite file instead (see db.py) -
# the whole service runs against either backend unchanged.
DATABASE_URL=

# Anthropic API key - used for per-session recap generation (recap_client.py).
# Same account as backend/voice/.env's ANTHROPIC_API_KEY works fine here.
ANTHROPIC_API_KEY=

# Where the eval service (backend/eval/server.py) is reachable - the
# engineering dashboard proxies GET /admin/eval_report through here.
# Defaults to http://localhost:8001, which is what ./dev.sh already starts -
# only set this if running the eval service somewhere else.
EVAL_SERVICE_URL=

# Optional: override the local SQLite file path used when DATABASE_URL is
# unset. Defaults to mastery_dev.db in this directory.
MASTERY_DB_PATH=
